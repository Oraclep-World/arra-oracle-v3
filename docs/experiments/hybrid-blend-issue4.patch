+/**
+ * Hybrid blend of the fts and vector legs (issue #4).
+ *
+ * `legacy` is the original formula, kept runnable (Nat: "revert but don't
+ * delete"). Switch with ARRA_HYBRID_BLEND, read per call.
+ * Empty fts or empty vector list ⇒ always legacy, so fts-only and
+ * vector-only modes keep byte-for-byte the same order.
+ */
+import type { SearchResult } from './types.ts';
+import { RRF_K } from '../db/search-dedupe.ts';
+
+export type HybridBlend = 'legacy' | 'rrf' | 'rrf-score' | 'rrf-max' | 'legacy-fused';
+
+export function hybridBlendMode(env: Record<string, string | undefined> = process.env): HybridBlend {
+  const v = env.ARRA_HYBRID_BLEND?.trim();
+  return v === 'rrf' || v === 'rrf-score' || v === 'rrf-max' || v === 'legacy-fused' ? v : 'legacy';
+}
+
+const clamp01 = (n: number | undefined) => Math.max(0, Math.min(1, n ?? 0));
+
+/** Original blend: 0.7×score+0.3×1/(rank+1) for fts, 0.65/0.35 for vector, +0.12 overlap. */
+export function combineLegacy(fts: SearchResult[], vector: SearchResult[]): SearchResult[] {
+  const seen = new Map<string, SearchResult>();
+  const addScore = (base: number | undefined, rank: number, scoreWeight: number, rankWeight: number) =>
+    clamp01(base) * scoreWeight + (1 / (rank + 1)) * rankWeight;
+
+  fts.forEach((r, index) => {
+    seen.set(r.id, { ...r, score: addScore(r.score, index, 0.7, 0.3) });
+  });
+  vector.forEach((r, index) => {
+    const vectorScore = addScore(r.score, index, 0.65, 0.35);
+    const existing = seen.get(r.id);
+    if (existing) {
+      seen.set(r.id, {
+        ...existing,
+        score: Math.min(1, (existing.score || 0) + vectorScore + 0.12),
+        source: 'hybrid' as const,
+        distance: r.distance,
+        model: r.model,
+      });
+    } else {
+      seen.set(r.id, { ...r, score: vectorScore });
+    }
+  });
+  return Array.from(seen.values()).sort((a, b) => (b.score || 0) - (a.score || 0));
+}
+
+/**
+ * Rank-based fusion (Nat's relic5): each list contributes 1/(k+rank), joined
+ * by position. `scoreWeight` > 0 multiplies by (1 + w × leg score) so distance
+ * is not thrown away (book line 94). Overlap rows sum both legs.
+ */
+function combineRrf(
+  fts: SearchResult[], vector: SearchResult[], scoreWeight: number, ftsFused: Map<string, number>,
+): SearchResult[] {
+  const acc = new Map<string, { row: SearchResult; rrf: number; s: number }>();
+  const add = (r: SearchResult, i: number, s: number, isVector: boolean) => {
+    const part = 1 / (Number(process.env.ARRA_HYBRID_K ?? RRF_K) + i + 1);
+    const cur = acc.get(r.id);
+    if (cur) {
+      cur.rrf += part;
+      cur.s = Math.max(cur.s, s);
+      if (isVector) Object.assign(cur.row, { source: 'hybrid' as const, distance: r.distance, model: r.model });
+    } else {
+      acc.set(r.id, { row: { ...r }, rrf: part, s });
+    }
+  };
+  fts.forEach((r, i) => add(r, i, ftsFused.get(r.id) ?? 0, false));
+  vector.forEach((r, i) => add(r, i, clamp01(r.score), true));
+  return [...acc.values()]
+    .map((a) => ({ ...a.row, score: a.rrf * (1 + scoreWeight * a.s) }))
+    .sort((a, b) => b.score - a.score);
+}
+
+/** Experiment: best leg position + β × the other leg's contribution. */
+function combineRrfMax(fts: SearchResult[], vector: SearchResult[], beta: number): SearchResult[] {
+  const k = Number(process.env.ARRA_HYBRID_K ?? RRF_K);
+  const acc = new Map<string, { row: SearchResult; f: number; v: number }>();
+  fts.forEach((r, i) => acc.set(r.id, { row: { ...r }, f: 1 / (k + i + 1), v: 0 }));
+  vector.forEach((r, i) => {
+    const cur = acc.get(r.id);
+    if (cur) Object.assign(cur, { v: 1 / (k + i + 1) }), Object.assign(cur.row, { source: 'hybrid' as const, distance: r.distance, model: r.model });
+    else acc.set(r.id, { row: { ...r }, f: 0, v: 1 / (k + i + 1) });
+  });
+  return [...acc.values()]
+    .map((a) => ({ ...a.row, score: Math.max(a.f, a.v) + beta * Math.min(a.f, a.v) }))
+    .sort((a, b) => b.score - a.score);
+}
+
+/** `ftsFused`: fts row id → fused (RRF over fts legs) score normalised to 0..1. */
+export function combineSearchResults(
+  fts: SearchResult[], vector: SearchResult[], ftsFused: Map<string, number> = new Map(),
+  mode: HybridBlend = hybridBlendMode(), scoreWeight = Number(process.env.ARRA_HYBRID_W ?? 1),
+): SearchResult[] {
+  if (mode === 'legacy' || fts.length === 0 || vector.length === 0) return combineLegacy(fts, vector);
+  if (mode === 'rrf-max') return combineRrfMax(fts, vector, scoreWeight);
+  if (mode === 'rrf') return combineRrf(fts, vector, 0, ftsFused);
+  if (mode === 'rrf-score') return combineRrf(fts, vector, scoreWeight, ftsFused);
+  // legacy-fused: legacy formula, fts rows fed the normalised fused score
+  return combineLegacy(fts.map((r) => ({ ...r, score: ftsFused.get(r.id) ?? r.score })), vector);
+}
